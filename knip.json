{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/entrypoints/*.ts",
        "src/entrypoints/*/main.tsx",
        "tests/e2e/serve.mjs",
        "scripts/*.mjs",
        "scripts/*/cli.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,mjs}",
        "scripts/**/*.{ts,mjs}",
        "*.config.ts"
      ]
    },
    "website": {
      "entry": ["src/entry-*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
