{
  "name": "sitemark",
  "description": "Mark production (or any) websites with ribbons, banners and outlines so you never confuse environments.",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Niels van Brakel (https://github.com/nielsbrakel)",
  "homepage": "https://nielsbrakel.github.io/SiteMark/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielsbrakel/SiteMark.git"
  },
  "bugs": {
    "url": "https://github.com/nielsbrakel/SiteMark/issues"
  },
  "keywords": [
    "browser-extension",
    "webextension",
    "chrome-extension",
    "firefox-addon",
    "safari-extension",
    "manifest-v3",
    "wxt",
    "react",
    "typescript",
    "environment",
    "production",
    "privacy"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:edge": "wxt build -b edge",
    "build:all": "wxt build && wxt build -b edge && wxt build -b firefox && wxt build -b safari",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "web:dev": "pnpm --filter @sitemark/website dev",
    "web:build": "pnpm --filter @sitemark/website build",
    "web:preview": "pnpm --filter @sitemark/website preview",
    "web:test:build": "pnpm web:build && vitest run --project website-build",
    "web:test:e2e": "pnpm web:build && playwright test --config website/playwright.config.ts",
    "web:screenshots": "wxt build --mode e2e && pnpm web:build && playwright test --config website/screenshots.config.ts",
    "postinstall": "wxt prepare",
    "prepare": "node scripts/install-hooks.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core && tsc --noEmit -p tests/e2e && tsc --noEmit -p website",
    "lint": "biome check --formatter-enabled=false",
    "lint:fix": "biome check --write",
    "stylelint": "stylelint 'src/**/*.css' 'website/src/**/*.css'",
    "format": "biome format --write && prettier --write '**/*.{md,yml,yaml}'",
    "format:check": "biome format && prettier --check '**/*.{md,yml,yaml}'",
    "knip": "knip",
    "test": "vitest run --project core --project dom --project scripts --project website-node --project website-dom",
    "test:watch": "vitest --project core --project dom --project scripts --project website-node --project website-dom",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage --project core --project dom --project browser --project scripts --project website-node --project website-dom",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "test:build": "pnpm build:all && vitest run --project build",
    "size": "wxt build && vitest run --project build tests/build/size.test.ts",
    "mutation": "stryker run",
    "icons": "node scripts/render-icons.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm stylelint && pnpm format:check && pnpm knip && pnpm test && pnpm progress --strict",
    "check:static": "pnpm typecheck && biome ci --reporter=github && stylelint 'src/**/*.css' 'website/src/**/*.css' --formatter unix && prettier --check '**/*.{md,yml,yaml}' && pnpm knip && pnpm progress --strict",
    "check:ci": "pnpm check:static && pnpm test:coverage",
    "progress": "node scripts/progress/cli.ts",
    "verify-tdd": "node scripts/verify-tdd/cli.ts"
  },
  "dependencies": {
    "@eslint-community/regexpp": "^4.12.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "prettier": "^3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "^5.9.3",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0",
    "web-ext": "10.8.0",
    "wxt": "~0.21.5",
    "yaml": "2.9.1"
  }
}
