{
  "name": "sitemark",
  "description": "Mark production (or any) websites with ribbons, banners and outlines so you never confuse environments.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Niels Brakel (https://github.com/nielsbrakel)",
  "homepage": "https://github.com/nielsbrakel/SiteMark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielsbrakel/SiteMark.git"
  },
  "bugs": {
    "url": "https://github.com/nielsbrakel/SiteMark/issues"
  },
  "keywords": [
    "browser-extension",
    "webextension",
    "chrome-extension",
    "firefox-addon",
    "safari-extension",
    "manifest-v3",
    "wxt",
    "react",
    "typescript",
    "environment",
    "production",
    "privacy"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --formatter-enabled=false",
    "format": "biome format --write && prettier --write '**/*.{md,yml,yaml}'",
    "format:check": "biome format && prettier --check '**/*.{md,yml,yaml}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build && playwright test",
    "icons": "node scripts/render-icons.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm progress --strict",
    "progress": "node scripts/progress.mjs",
    "changeset": "changeset"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@wxt-dev/module-react": "^1.2.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wxt": "^0.21.0"
  }
}
