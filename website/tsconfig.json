{
  // The website (D-244) uses the root strict config. Extension code is reached through the `@/` alias
  // that the root config inherits from WXT, and only the layers D-246 allows (Biome enforces it).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  // globals.d.ts declares __SHADOW_MODE__, which the shared mark preview uses (D-278).
  "include": ["src", "scripts", "tests", "*.config.ts", "../src/globals.d.ts"],
  "exclude": ["dist"]
}
